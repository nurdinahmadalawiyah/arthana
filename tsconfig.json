{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@core": ["./src/core"],
      "@core/*": ["./src/core/*"],
      "@features": ["./src/features"],
      "@features/*": ["./src/features/*"],
      "@shared": ["./src/shared"],
      "@shared/*": ["./src/shared/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "uniwind-env.d.ts"]
}
