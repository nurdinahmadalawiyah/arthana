{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@core": ["./src/core"],
      "@core/*": ["./src/core/*"],
      "@domain": ["./src/domain"],
      "@domain/*": ["./src/domain/*"],
      "@data": ["./src/data"],
      "@data/*": ["./src/data/*"],
      "@presentation": ["./src/presentation"],
      "@presentation/*": ["./src/presentation/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "uniwind-env.d.ts"]
}
